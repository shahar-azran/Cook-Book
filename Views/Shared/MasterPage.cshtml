
@{
    ViewData["Title"] = "MasterPage";
	bool isLoggedIn = Convert.ToBoolean(ViewBag.Login);
}
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<link href="~/css/homestylesheet.css" rel="stylesheet" />
<div class="wraper">
    <header>
        <div class="logo">
            <img src="~/Images/Logo.png" />
        </div>

        <nav>
            <ul>
                @if(isLoggedIn==true)
                {
                    <li><a href="https://localhost:7222/User/ViewUserHomePage">Home</a></li>
					<li><a href="https://localhost:7222/Home/ViewHomePage">Log Out</a></li>
					<li><a href="https://localhost:7222/User/GetOwnRecipes">Own Recipes</a></li>
                    <li><a href="https://localhost:7222/User/ViewUserAbout">About</a></li>
                    <li>
                        <a href="https://localhost:7222/User/DeleteAccount"
                           onclick="return confirm('Are you sure you want to delete your account?');"
                           style="margin-left: auto; color: #d9534f; border: 2px solid #d9534f; padding: 6px 16px; border-radius: 25px; font-weight: 600; font-size: 0.9rem; text-decoration: none; transition: all 0.2s ease-in-out; background-color: rgba(217, 83, 79, 0.05);"
                           onmouseover="this.style.backgroundColor='#d9534f'; this.style.color='#ffffff';"
                           onmouseout="this.style.backgroundColor='rgba(217, 83, 79, 0.05)'; this.style.color='#d9534f';">
                            Delete Account
                        </a>
                    </li>
                        
                }
                else
                {
                    <li><a href="https://localhost:7222/Home/ViewHomePage">Home</a></li>
                    <li><a href="https://localhost:7222/Home/ViewAbout">About</a></li>
                }
               
                

            </ul>
        </nav>


    </header>
    
    <main class="main">
		@RenderBody()
    </main>

    <footer>
        <p>&copy; 2026 CookBook. All Rights Reserved.</p>
    </footer>
</div>

