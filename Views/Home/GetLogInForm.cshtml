@{
    ViewData["Title"] = "GetLogInForm";
    Layout = "~/Views/Shared/MasterPage.cshtml";
}
<link href="~/css/loginstylesheet.css" rel="stylesheet" />
<div class="login-container">
    <div class="brand-header">
        <h2>Log In</h2>
        <p>Welcome back! Ready to cook something new?</p>
    </div>

    @if (ViewBag.LoginError != null)
    {
        <div class="error-message">
            <h1>
                Your LogIn has failed, Try Again
            </h1>
        </div>
    }
    <form action="/Home/LogIn" method="post" class="login-form" onsubmit="return validateLogIn();">
        <div class="input-group">
            <input type="text" id="username" name="username" placeholder=" ">
            <label for="username">User Name</label>
            <div class="input-bar"></div>
        </div>
        <div class="input-group">
            <input type="password" name="password" id="password" placeholder=" ">
            <label for="password">Password</label>
            <div class="input-bar"></div>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-send">Send</button>
            <button type="reset" class="btn btn-clear">Clear</button>
        </div>

    </form>
    <div class="form-footer">
        <span>Don't have an account?</span>
        <a href="~/Home/GetSignUpForm" class="signup-link">Sign Up</a>
    </div>

</div>

<script>
    function validateLogIn() 
    {
        var username = document.getElementById("username").value.trim();
        var password = document.getElementById("password").value.trim();

        if (username === "")
        {
            alert("Please enter your User Name.");
            return false;
        }
        if (password === "")
        {
            alert("Please enter your Password.");
            return false;
        }
        return true;
    }
</script>