@using Cook_Book.Models
@model Recipes
@{
    ViewData["Title"] = Model.GetRecipesName();
    Layout = "~/Views/Shared/MasterPage.cshtml";
}

<div class="recipe-details-container">
    <div class="details-card">
        <h1 class="recipe-title">@Model.GetRecipesName()</h1>

        <div class="recipe-content-body">
            <div class="image-wrapper">
                <img src="~/Images/@Model.GetDishPhoto()" alt="@Model.GetRecipesName()" />
            </div>

            <div class="method-section">
                <h2>Preparation Method</h2>
                <div class="method-box">
                    <p>@Model.GetPreperationMethod()</p>
                </div>
            </div>
        </div>

        <div class="actions">
            <a href="javascript:history.back()" class="back-btn">&laquo; Back to Recipes</a>
        </div>
    </div>
</div>

<style>
    .recipe-details-container {
        width: 100%;
        max-width: 950px;
        margin: 30px auto;
        padding: 0 20px;
        box-sizing: border-box;
    }

    .details-card {
        background-color: #fdf6ec;
        border-radius: 40px;
        padding: 40px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.03);
        font-family: 'Comfortaa', cursive, sans-serif;
    }

    .recipe-title {
        font-size: 34px;
        color: #2c3e50;
        text-align: center;
        margin-top: 0;
        margin-bottom: 35px;
    }

    .recipe-content-body {
        display: flex;
        gap: 30px;
        align-items: flex-start;
    }

    .image-wrapper {
        flex: 1;
        max-width: 40%;
        border-radius: 25px;
        overflow: hidden;
        box-shadow: 0 8px 20px rgba(0,0,0,0.06);
    }

        .image-wrapper img {
            width: 100%;
            height: 260px;
            object-fit: cover;
            display: block;
        }

    .method-section {
        flex: 1.2;
        display: flex;
        flex-direction: column;
    }

        .method-section h2 {
            font-size: 22px;
            color: #e67e22;
            margin-top: 0;
            margin-bottom: 15px;
        }

    .method-box {
        background: #ffffff;
        padding: 20px;
        border-radius: 25px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
    }

    .method-section p {
        font-size: 15px;
        line-height: 1.7;
        color: #555;
        margin: 0;
        white-space: pre-line;
    }

    .actions {
        margin-top: 40px;
        text-align: center;
    }

    .back-btn {
        display: inline-block;
        padding: 10px 28px;
        background-color: #ff8c00;
        color: #ffffff;
        text-decoration: none;
        border-radius: 20px;
        font-weight: bold;
        transition: all 0.2s ease;
    }

        .back-btn:hover {
            background-color: #e07b00;
            transform: translateY(-2px);
        }

    .image-wrapper {
        max-width: 100%;
        width: 100%;
    }

    }
</style>