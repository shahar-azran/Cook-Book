@using Cook_Book.Models
@model CookBookViewModel
@{
    ViewData["Title"] = "ViewAllRecipes";
    Layout = "~/Views/Shared/MasterPage.cshtml";

    int pageSize = 6;
    int currentPage = 1;

    if (Context.Request.Query.ContainsKey("page"))
    {
        int.TryParse(Context.Request.Query["page"], out currentPage);
    }

    int selectedCatId = 0;
    if (Context.Request.Query.ContainsKey("catId"))
    {
        int.TryParse(Context.Request.Query["catId"], out selectedCatId);
    }

    List<Recipes> filteredRecipes = new List<Recipes>();

    if (Model != null)
    {
        for (int i = 0; i < Model.GetRecipeCount(); i++)
        {
            var r = Model.GetRecipes(i);

            if (selectedCatId == 0 || r.GetCatId() == selectedCatId)
            {
                filteredRecipes.Add(r);
            }
        }
    }

    int totalRecipes = filteredRecipes.Count;

    int startIndex = (currentPage - 1) * pageSize;
    int endIndex = startIndex + pageSize;

    if (endIndex > totalRecipes)
    {
        endIndex = totalRecipes;
    }

    int totalPages = totalRecipes / pageSize;
    if (totalRecipes % pageSize > 0)
    {
        totalPages = totalPages + 1;
    }
}

<main class="all-recipes-page">
    <div class="main-card">

        <div class="page-header">
            <h1 class="page-title">All Recipes</h1>

            <div class="filter-area">
                <label for="categoryFilter">Filter by Category:</label>
                <select id="categoryFilter" class="category-select" onchange="filterByCategory(this.value)">
                    <option value="0">All Categories</option>
                    @if (Model != null)
                    {
                        if (Model.GetRecipeCatagoriesCount() > 0)
                        {
                            for (int i = 0; i < Model.GetRecipeCatagoriesCount(); i++)
                            {
                                var category = Model.GetRecipeCatagory(i);
                                if (category.GetCatId() == selectedCatId)
                                {
                                    <option value="@category.GetCatId()" selected="selected">@category.GetCatagoryName()</option>
                                }
                                else
                                {
                                    <option value="@category.GetCatId()">@category.GetCatagoryName()</option>
                                }
                            }
                        }
                    }
                </select>
            </div>
        </div>

        <div class="recipes-grid">
            @if (totalRecipes > 0)
            {
                if (startIndex < totalRecipes)
                {
                    for (int j = startIndex; j < endIndex; j++)
                    {
                        var recipe = filteredRecipes[j];
                        <div class="recipe-card">
                            <div class="recipe-image">
                                <img src="~/Images/@recipe.GetDishPhoto()" alt="@recipe.GetRecipesName()" />
                            </div>

                            <div class="recipe-info">
                                <h3>@recipe.GetRecipesName()</h3>
                                <p>@recipe.GetPreperationMethod()</p>
                            </div>
                        </div>
                    }
                }
            }
            else
            {
                <p class="no-recipes">No recipes found in this category.</p>
            }
        </div>

        @if (totalPages > 1)
        {
            <div class="pagination-container">
                @if (currentPage > 1)
                {
                    <a href="?page=@(currentPage - 1)&catId=@selectedCatId" class="page-btn prev-btn">&laquo; Prev</a>
                }

                @for (int p = 1; p <= totalPages; p++)
                {
                    if (p == currentPage)
                    {
                        <span class="page-btn active">@p</span>
                    }
                    else
                    {
                        <a href="?page=@p&catId=@selectedCatId" class="page-btn">@p</a>
                    }
                }

                @if (currentPage < totalPages)
                {
                    <a href="?page=@(currentPage + 1)&catId=@selectedCatId" class="page-btn next-btn">Next &raquo;</a>
                }
            </div>
        }
    </div>
</main>

<script>
    function filterByCategory(catId) {
        window.location.href = "?page=1&catId=" + catId;
    }
</script>

